APP_NAME="Workplanner 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:5173
WORKPLANNER_PUBLIC_URL=https://workplanner.trevorsadd.co.uk
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workplanner_2_0
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Time Tracking API (https://timetracking.trevorsadd.co.uk)
TIMETRACKING_BASE_URL=https://timetracking.trevorsadd.co.uk
TIMETRACKING_LOGIN=yomna
TIMETRACKING_PASSWORD=

# TSA availability Google Sheet (scheduled import Tue/Fri)
GOOGLE_SHEETS_API_KEY=
AVAILABILITY_SPREADSHEET_ID=1Tb09YWWG-w8V4QCYZyrmz-uXvYeRl-ZJa5DW5C1QAf8
AVAILABILITY_SCHEDULED_MONTHS=3

# Google Drive quotation spreadsheets (New Project picker)
# Path to service-account JSON key file, or the JSON string itself.
# Grant the service account Viewer access on the quotations folder (and subfolders).
# TSA Quotations root (contains year folders like "2026 Quotations"):
# https://drive.google.com/drive/folders/1UGqCrGCqfVFrpEmM8tU3I2XOdDUtGnHA
# TSA Quotations root:
# https://drive.google.com/drive/folders/1UGqCrGCqfVFrpEmM8tU3I2XOdDUtGnHA
# Prefer the year folder (faster), e.g. 2026 Quotations:
# https://drive.google.com/drive/folders/1QGML2ZNKqAr252zHNYHT9O8TqdyKAw9B
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_QUOTATIONS_FOLDER_ID=1QGML2ZNKqAr252zHNYHT9O8TqdyKAw9B
# Optional: if FOLDER_ID is the TSA root, set this to 2026 to scope to that year subfolder.
GOOGLE_DRIVE_QUOTATIONS_YEAR_FOLDER=
# Only list quotations from N months ago through end of the current month (faster).
GOOGLE_DRIVE_LIST_MONTHS_BACK=1
GOOGLE_DRIVE_REQUIRED_SHEET_NAME="Adjudication - TEMPL"

# Sales Tool integration (System Monitor probe + ST → WP project upsert)
# SALES_TOOL_BASE_URL = Sales Tool API origin (no trailing slash).
# Local: http://127.0.0.1:8000
# Hosted: https://workplannertest.trevorsadd.co.uk/SalesTool
# Local WP API uses :8001 (see APP_URL / php artisan serve --port=8001).
# Token must match WORKPLANNER_INTEGRATION_TOKEN on the Sales Tool backend.
SALES_TOOL_BASE_URL=
SALES_TOOL_INTEGRATION_TOKEN=

# Live Home sync from Sales Tool MySQL (crm_deals → pending proposals)
SALES_TOOL_LIVE_SYNC=true
SALES_TOOL_LIVE_SYNC_LIMIT=80
SALES_TOOL_DB_HOST=127.0.0.1
SALES_TOOL_DB_PORT=3306
SALES_TOOL_DB_DATABASE=salestool
SALES_TOOL_DB_USERNAME=root
SALES_TOOL_DB_PASSWORD=

# Outlook / Microsoft Graph (same apps as Sales Tool)
# Deals & Enquiries → enquiries@trevorsadd.co.uk
OUTLOOK_DEALS_TENANT_ID=
OUTLOOK_DEALS_CLIENT_ID=
OUTLOOK_DEALS_CLIENT_SECRET=
OUTLOOK_DEALS_MAILBOX=enquiries@trevorsadd.co.uk
# Angela (Leads) → angela.lane@trevorsadd.co.uk
OUTLOOK_LEADS_TENANT_ID=
OUTLOOK_LEADS_CLIENT_ID=
OUTLOOK_LEADS_CLIENT_SECRET=
OUTLOOK_LEADS_MAILBOX=angela.lane@trevorsadd.co.uk
